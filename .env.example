# Copy to .env and fill in real values:
#   cp .env.example .env

# Server
PORT=5000

# App URLs (comma-separated allowed). First FRONTEND_URL is used for Stripe redirects and emails.
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
ADMIN_URL=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Public origin for uploaded files (production). Leave empty for local relative /uploads paths.
# PUBLIC_API_URL=https://wealth-backend-omega.vercel.app
# BACKEND_PUBLIC_URL=
# API_PUBLIC_URL=
# UPLOAD_URL_MODE=relative

# Uploads: local disk, Firebase Storage, or auto (Firebase on Vercel)
# UPLOAD_DRIVER=local
# USE_FIREBASE_STORAGE=false

# Firebase Admin — pick ONE method
# 1) Service account JSON file in this folder
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./firebase-service-account.json
# 2) Split fields
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# 3) Full JSON blob
# FIREBASE_SERVICE_ACCOUNT=
FIREBASE_STORAGE_BUCKET=
# GCLOUD_STORAGE_BUCKET=

# OpenAI (writer / script / student AI tools)
OPENAI_API_KEY=

# Optional: live YouTube results for Course Video Finder
YOUTUBE_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin panel login (POST /api/auth/admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=change-this-to-a-long-random-string
ADMIN_NAME=Ink2Wealth Admin

# Brevo SMTP (transactional email)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=c38f96001@smtp-brevo.com
SMTP_PASS=
SMTP_FROM=Ink2Wealth <victor@ink2wealth.co>
SMTP_REPLY_TO=support@ink2wealth.co

# Cron jobs: Authorization: Bearer <CRON_SECRET> or x-cron-secret header
CRON_SECRET=

# Optional Web3 / NFT (defaults keep simulation / off)
# NFT_MINT_MODE=simulation
# NFT_CONTRACT_ADDRESS=
# NFT_NETWORK=
# NFT_EXPLORER_BASE=
# TOKEN_GATE_CHAIN_VERIFY=false
# WALLET_ROYALTIES_LIVE=false
# WALLET_ROYALTIES_NETWORKS=
